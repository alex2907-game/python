set.seed(123)
# Sample dataset with correct lengths
data <- data.frame(
  Study_Method = rep(c("A", "B", "C"), each = 5),
  Gender = rep(c("M", "F"), length.out = 15),  
  Performance = c(70, 75, 80, 85, 90, 65, 70, 75, 80, 85, 68, 72, 78, 82, 88)
)
# One-way ANOVA
summary(aov(Performance ~ Study_Method, data = data))
# Two-way ANOVA
summary(aov(Performance ~ Study_Method + Gender, data = data))
