set.seed(123)
data <- data.frame(
  Study_Hours = c(2, 3, 5, 7, 9, 10, 12, 15, 18, 20),
  Attendance = c(80, 85, 78, 90, 88, 92, 95, 98, 99, 100),
  Performance = c(60, 65, 70, 75, 80, 85, 88, 90, 92, 95)
)
# Linear Regression: Performance ~ Study_Hours
linear_model <- lm(Performance ~ Study_Hours, data = data)
summary(linear_model)
# Multiple Regression: Performance ~ Study_Hours + Attendance
multiple_model <- lm(Performance ~ Study_Hours + Attendance, data = data)
summary(multiple_model)
# Plot Linear Regression
plot(data$Study_Hours, data$Performance, main = "Performance vs Study Hours",
     xlab = "Study Hours", ylab = "Performance", pch = 16, col = "blue")
abline(linear_model, col = "red", lwd = 2)
# Plot Multiple Regression (Performance vs Fitted Values)
plot(fitted(multiple_model), data$Performance, main = "Performance vs Fitted Values",
     xlab = "Fitted Values", ylab = "Performance", pch = 16, col = "green")
abline(0, 1, col = "red", lwd = 2)
