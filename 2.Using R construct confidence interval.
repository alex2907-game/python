1. Confidence Interval for mean (Normal Distribution)
# sample data 
data<-c(5.1,6.2,4.8,5.9,6.3,5.4,6.0,5.5,5.8,6.1)
#confidence interval for mean
t.test(data , conf.level = 0.95)

2. Confidence Interval for Population Proportion
# Example: 45 successes out of 100 trials
prop.test(45,100,conf.level = 0.95)

3. Confidence Interval for Mean Difference (Paired Samples)

#  For dependent paired samples:
before<-c(10,12,9,15,14,13,11,12)
after<-c(9,13,14,11,12,10,8,11) 
t.test(before , after , paired = TRUE , conf.level = 0.95)

4.Confidence Interval for Variance
install.packages("EnvStats")
library(EnvStats)
varTest(data,conf.level = 0.95)

5. Confidence Interval for Regression Coefficients
model<- lm(mpg ~ hp,data = mtcars)
confint(model,level = 0.95)
