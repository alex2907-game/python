install.packages("readxl")   # For Excel files
install.packages("tidyverse") # For data manipulation (optional)
library(readxl)
# Load Excel file 
data <- read_excel("data.xlsx", sheet = 1)
# Check the first few rows
head(data)
# Assuming the data has two columns: 'before' and 'after'
before <- data$Before
after  <- data$After
# Perform paired t-test
t_test_result <- t.test(before, after, paired = TRUE, alternative = "two.sided")
# Print the results
print(t_test_result)
# Decision based on p-value
alpha <- 0.05
if (t_test_result$p.value < alpha) {
  cat("Conclusion: There is a significant difference between 'before' and 'after' (Reject H0)\n")
} else {
  cat("Conclusion: There is no significant difference (Fail to reject H0)\n")
}
